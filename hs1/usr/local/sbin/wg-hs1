#!/bin/bash
# Manage the hs1 WireGuard server (wg0) and its peers.
#
#   wg-hs1 add NAME     generate keys for a new peer, assign the next free IP, apply
#   wg-hs1 render       rebuild wg0.conf + client configs from peers and apply
#                       (creates any missing server/peer keys)
#   wg-hs1 show NAME    print a peer's client config
#   wg-hs1 qr NAME      print a peer's client config as a QR code (scan in the app)
#
# Files (all root-only, under /etc/wireguard):
#   server.key / server.pub     server keypair
#   peers                       "NAME IP" per line (source of truth)
#   clients/NAME.{key,pub,conf} per-peer keypair and generated client config
#   wg0.conf                    generated server config (do not edit by hand)
set -euo pipefail

WG_DIR=/etc/wireguard
IFACE=wg0
SUBNET_PREFIX=10.20.0          # /24; .1 is hs1
SERVER_ADDR=${SUBNET_PREFIX}.1
LISTEN_PORT=51820
LAN_IF=enp2s0
ENDPOINT=vpn.home.campbellsoftware.co.uk:${LISTEN_PORT}
# Routes the phones send through the tunnel (split tunnel). Today only hs1
# (Caddy -> Home Assistant). To expose the whole LAN later, change this to
# "192.168.1.0/24, ${SERVER_ADDR}/32", run `wg-hs1 render`, re-import the phone
# configs, and add the ufw route rule described in SETUP.md.
CLIENT_ALLOWED_IPS="192.168.1.2/32, ${SERVER_ADDR}/32"

umask 077
cd "$WG_DIR"
touch peers

die() { echo "error: $*" >&2; exit 1; }
valid_name() { [[ $1 =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid peer name '$1'"; }
peer_ip() { awk -v n="$1" '$1==n {print $2}' peers; }

render() {
  [ -f server.key ] || { wg genkey > server.key; }
  wg pubkey < server.key > server.pub
  local server_pub; server_pub=$(cat server.pub)

  {
    echo "# Generated by wg-hs1 - edit $WG_DIR/peers and run 'wg-hs1 render'"
    echo "[Interface]"
    echo "Address = ${SERVER_ADDR}/24"
    echo "ListenPort = ${LISTEN_PORT}"
    echo "PrivateKey = $(cat server.key)"
    # NAT for VPN clients reaching other LAN hosts. Inert until ufw allows
    # routing wg0 -> ${LAN_IF} (default: routed traffic denied).
    echo "PostUp = iptables -t nat -A POSTROUTING -s ${SUBNET_PREFIX}.0/24 -o ${LAN_IF} -j MASQUERADE"
    echo "PostDown = iptables -t nat -D POSTROUTING -s ${SUBNET_PREFIX}.0/24 -o ${LAN_IF} -j MASQUERADE"
    while read -r name ip; do
      [ -n "${name:-}" ] && [[ $name != \#* ]] || continue
      mkdir -p clients
      [ -f "clients/${name}.key" ] || wg genkey > "clients/${name}.key"
      wg pubkey < "clients/${name}.key" > "clients/${name}.pub"
      echo
      echo "[Peer] # ${name}"
      echo "PublicKey = $(cat "clients/${name}.pub")"
      echo "AllowedIPs = ${ip}/32"

      cat > "clients/${name}.conf" <<EOF
[Interface]
PrivateKey = $(cat "clients/${name}.key")
Address = ${ip}/32

[Peer]
PublicKey = ${server_pub}
Endpoint = ${ENDPOINT}
AllowedIPs = ${CLIENT_ALLOWED_IPS}
EOF
    done < peers
  } > "${IFACE}.conf.new"
  mv "${IFACE}.conf.new" "${IFACE}.conf"

  if ip link show "$IFACE" >/dev/null 2>&1; then
    wg syncconf "$IFACE" <(wg-quick strip "$IFACE")
    echo "applied to running $IFACE"
  fi
}

case "${1:-}" in
  add)
    name=${2:-}; valid_name "$name"
    [ -z "$(peer_ip "$name")" ] || die "peer '$name' already exists"
    for i in $(seq 2 254); do
      ip="${SUBNET_PREFIX}.$i"
      awk -v ip="$ip" '$2==ip {f=1} END {exit !f}' peers || break
    done
    echo "$name $ip" >> peers
    render
    echo "added $name as $ip - run: wg-hs1 qr $name"
    ;;
  render) render ;;
  show)   valid_name "${2:-}"; cat "clients/$2.conf" ;;
  qr)     valid_name "${2:-}"; qrencode -t ansiutf8 < "clients/$2.conf" ;;
  *)      sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
