{
	email admin@campbellsoftware.co.uk
	admin localhost:2019
}

# Add future internal service routes as explicit host matchers in this block.
*.home.campbellsoftware.co.uk, home.campbellsoftware.co.uk {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			dns digitalocean {env.DO_AUTH_TOKEN}
		}
	}

	@ha host ha.home.campbellsoftware.co.uk
	handle @ha {
		reverse_proxy 192.168.1.2:8123
	}

	@test host test.home.campbellsoftware.co.uk
	handle @test {
		respond "Caddy on hs1 is working" 200
	}

	# Unknown internal service names are intentionally not served.
	handle {
		abort
	}
}

# Plain-HTTP LAN endpoint for devices that can't use the TLS names (router DNS
# rebind protection blocks ha.home.* on the LAN), e.g. the Playroom TV's PiPup
# app loading the doorbell snapshot. Only the doorbell camera's snapshot is
# passed through; HA still requires the camera's short-lived access token.
http://192.168.1.2 {
	@doorbell_snapshot {
		method GET
		path /api/camera_proxy/camera.front_door_live_view
	}
	handle @doorbell_snapshot {
		reverse_proxy 192.168.1.2:8123
	}
	handle {
		abort
	}
}
